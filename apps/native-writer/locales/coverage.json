      "\\(\\s*\"und\"\\s*,\\s*crate::ui_text::text\\(\\s*\"language.unspecified\"\\s*\\)\\s*\\)",
      "\\(\\s*\"auto\"\\s*,\\s*crate::ui_text::text\\(\\s*\"format.auto_direction\"\\s*\\)\\s*\\)",
      "\\(\\s*\"ltr\"\\s*,\\s*crate::ui_text::text\\(\\s*\"format.ltr\"\\s*\\)\\s*\\)",
      "\\(\\s*\"rtl\"\\s*,\\s*crate::ui_text::text\\(\\s*\"format.rtl\"\\s*\\)\\s*\\)",
      "style\\.append\\(\\s*Some\\(\\s*\"paragraph\"\\s*\\)\\s*,\\s*crate::ui_text::text\\(\\s*\"format.paragraph\"\\s*\\)\\s*\\)",
      "style\\.append\\(\\s*Some\\(\\s*\"heading\"\\s*\\)\\s*,\\s*crate::ui_text::text\\(\\s*\"format.heading\"\\s*\\)\\s*\\)",
      "\"planning\"\\s*=>\\s*crate::ui_text::text\\(\\s*\"page.story_notes\"\\s*\\)",
      "\"settings\"\\s*=>\\s*crate::ui_text::text\\(\\s*\"page.review_settings\"\\s*\\)",
      "\"sceneMetadata\"\\s*=>\\s*crate::ui_text::text\\(\\s*\"page.scene_details\"\\s*\\)",
