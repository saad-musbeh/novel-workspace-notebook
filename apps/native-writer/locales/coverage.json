      "self\\.group\\(\\s*\"Project\"\\s*\\)",
      "\\(\\s*\"en\"\\s*,\\s*crate::ui_text::text\\(\\s*\"language.english\"\\s*\\)\\s*\\)",
      "\\(\\s*\"ar\"\\s*,\\s*crate::ui_text::text\\(\\s*\"language.arabic\"\\s*\\)\\s*\\)",
      "\\(\\s*\"zh-Hans\"\\s*,\\s*crate::ui_text::text\\(\\s*\"language.zh_hans\"\\s*\\)\\s*\\)",
